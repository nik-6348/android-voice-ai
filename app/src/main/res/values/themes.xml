<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default; values-night switches to the dark parent. Compose sets the final bar colours. -->
    <style name="Theme.NikVoiceAssistant" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/system_bar</item>
        <item name="android:navigationBarColor">@color/system_bar</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Assistant gesture entry (AssistActivity): no window of its own, the app underneath stays visible -->
    <style name="Theme.NikVoiceAssistant.Assist" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
